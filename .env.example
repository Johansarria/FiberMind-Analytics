# ─────────────────────────────────────────────
# FiberMind Analytics - Configuración
# Copia a .env y edita los valores
# ─────────────────────────────────────────────

# --- Base de Datos ---
DB_PATH=ftth_mantenimiento.db
# DB_POSTGRES_URI=postgresql://fibermind:fibermind_secret@localhost:5432/fibermind

# --- IA Local (Ollama) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b

# --- Telegram Bot (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTHORIZED_CHAT_ID=0

# --- Google Gemini (alternativa a Ollama) ---
GEMINI_API_KEY=

# --- Modo de Operación ---
# development | production | demo
FIBERMIND_MODE=demo

# --- Demo: datos de prueba ---
FIBERMIND_DEMO_ISP=Chiminangos
FIBERMIND_DEMO_CABLE=8
